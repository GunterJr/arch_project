:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5d240b3dc8d0 .scope module, "bitshift_tb" "bitshift_tb" 2 4;
 .timescale -9 -9;
v0x5d240b3efd30_0 .var "dir", 0 0;
v0x5d240b3efdd0_0 .var/s "in", 3 0;
v0x5d240b3efea0_0 .net/s "out", 3 0, L_0x5d240b3f03f0;  1 drivers
S_0x5d240b3dca60 .scope module, "uut" "bitshift" 2 10, 3 2 0, S_0x5d240b3dc8d0;
 .timescale -9 -9;
    .port_info 0 /INPUT 4 "in";
    .port_info 1 /INPUT 1 "dir";
    .port_info 2 /OUTPUT 4 "out";
v0x5d240b3a3490_0 .net *"_ivl_0", 3 0, L_0x5d240b3f00c0;  1 drivers
v0x5d240b3ef680_0 .net *"_ivl_2", 2 0, L_0x5d240b3effa0;  1 drivers
L_0x74a00589d018 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x5d240b3ef760_0 .net *"_ivl_4", 0 0, L_0x74a00589d018;  1 drivers
v0x5d240b3ef820_0 .net *"_ivl_6", 3 0, L_0x5d240b3f02d0;  1 drivers
v0x5d240b3ef900_0 .net *"_ivl_8", 2 0, L_0x5d240b3f0230;  1 drivers
v0x5d240b3efa30_0 .net "dir", 0 0, v0x5d240b3efd30_0;  1 drivers
v0x5d240b3efaf0_0 .net/s "in", 3 0, v0x5d240b3efdd0_0;  1 drivers
v0x5d240b3efbd0_0 .net/s "out", 3 0, L_0x5d240b3f03f0;  alias, 1 drivers
L_0x5d240b3effa0 .part v0x5d240b3efdd0_0, 0, 3;
L_0x5d240b3f00c0 .concat [ 1 3 0 0], L_0x74a00589d018, L_0x5d240b3effa0;
L_0x5d240b3f0230 .part v0x5d240b3efdd0_0, 1, 3;
L_0x5d240b3f02d0 .extend/s 4, L_0x5d240b3f0230;
L_0x5d240b3f03f0 .functor MUXZ 4, L_0x5d240b3f02d0, L_0x5d240b3f00c0, v0x5d240b3efd30_0, C4<>;
    .scope S_0x5d240b3dc8d0;
T_0 ;
    %vpi_call 2 14 "$dumpfile", "bitshift_tb.vcd" {0 0 0};
    %vpi_call 2 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5d240b3dc8d0 {0 0 0};
    %pushi/vec4 6, 0, 4;
    %store/vec4 v0x5d240b3efdd0_0, 0, 4;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d240b3efd30_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 6, 0, 4;
    %store/vec4 v0x5d240b3efdd0_0, 0, 4;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d240b3efd30_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x5d240b3efdd0_0, 0, 4;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d240b3efd30_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x5d240b3efdd0_0, 0, 4;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d240b3efd30_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 33 "$display", "Testing bitshift" {0 0 0};
    %end;
    .thread T_0;
